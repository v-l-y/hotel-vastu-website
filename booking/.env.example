APP_NAME="Hotel Vastu Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_vastu_booking
DB_USERNAME=root
DB_PASSWORD=

# Redis is the production-safe shared backend for cache, sessions and rate limits.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_LIMITER=redis
QUEUE_CONNECTION=sync


# Customer communication.
# Local development logs OTP/SMS and email instead of sending them.
# To deliver confirmation/reminder/no-show mail to Gmail or another inbox in production, set MAIL_MAILER=smtp and valid SMTP credentials.
# Production booking confirmation requires SMS_DRIVER=webhook with a real provider adapter endpoint.
SMS_DRIVER=log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER_ID=HOTELVASTU

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=booking@hotelvastu.com
MAIL_FROM_NAME="Hotel Vastu Premium"

# Optional online payments — keep secrets outside version control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Official billing identity (use the hotel's real legal/tax details in production)
BILLING_LEGAL_NAME="Hotel Vastu Premium"
BILLING_TRADE_NAME="Hotel Vastu Premium"
BILLING_ADDRESS=
BILLING_STATE=
BILLING_STATE_CODE=
BILLING_GSTIN=
BILLING_PHONE=
BILLING_EMAIL=
BILLING_AUTHORISED_SIGNATORY=
BILLING_SAC_ACCOMMODATION=9963
BILLING_SAC_RESTAURANT=9963
